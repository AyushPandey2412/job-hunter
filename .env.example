# ============================================================================
# JOB HUNTER AUTONOMOUS ENGINE - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server & UI
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# Discord Webhooks (Create channels in Discord -> Channel Settings -> Integrations -> Webhooks)
# ----------------------------------------------------------------------------
# General / Default webhook (if specific ones below are empty)
DISCORD_WEBHOOK_URL=

# Channel: #remote-jobs (Filtered for 100% Remote / Distributed roles)
DISCORD_WEBHOOK_REMOTE=

# Channel: #startups (Fast-growing startups, Series A-C, Wellfound/Ashby)
DISCORD_WEBHOOK_STARTUPS=

# Channel: #mnc-careers (Big MNC & Enterprise career boards)
DISCORD_WEBHOOK_MNC=

# Channel: #high-priority (90%+ Tech Stack Match or Urgent postings)
DISCORD_WEBHOOK_URGENT=

# ----------------------------------------------------------------------------
# Candidate Preferences & Filters
# ----------------------------------------------------------------------------
TARGET_ROLES=Full Stack,Frontend,Backend,Software Engineer,MERN,Node.js,React,JavaScript,TypeScript,Python,SDE,Web Developer,full-stack,fullstack,front-end,back-end,software developer
TARGET_KEYWORDS=react,nodejs,node,typescript,javascript,express,nextjs,mongodb,postgres,sql,redis,aws,docker,rest api,reactjs,react.js,node.js,next.js,express.js,postgresql,graphql,html,css,tailwind,git,jest,vitest,playwright
NEGATIVE_KEYWORDS=senior,staff,lead,architect,principal,director,manager,8+ years,10+ years,5+ years
MIN_MATCH_SCORE=45
TARGET_LOCATIONS=remote,india,bangalore,bengaluru,delhi,noida,gurgaon,pune,hyderabad,mumbai

# ----------------------------------------------------------------------------
# Polling Schedule & Rate Limits
# ----------------------------------------------------------------------------
POLL_INTERVAL_MINUTES=5
# Use 5 or 10. The server must remain running. Restart after changing.
# DB_PATH=/app/data/jobs.db
MAX_JOBS_PER_CYCLE=50

# ----------------------------------------------------------------------------
# Redis & BullMQ (Optional - System uses lightweight in-memory/SQLite queue if empty)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or Upstash Redis URL:
# REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379

# Free hosted deployment
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_PASSWORD=

# Full requirements are cached for six hours. Detail failures appear in source coverage.
JOB_DETAIL_LIMIT=300

# Optional recruiter lookup: never put API keys in browser code.
HUNTER_API_KEY=

# Optional email sending. Add these to local .env or deployment secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OUTREACH_FROM=
# Only explicitly approved drafts enter the automatic queue.
OUTREACH_AUTO_SEND=false
OUTREACH_DAILY_LIMIT=10
CANDIDATE_NAME=
CANDIDATE_SUMMARY=
CANDIDATE_PORTFOLIO=
